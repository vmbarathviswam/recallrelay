{
  "name": "recallrelay",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "node scripts/preview-demo.mjs",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test test/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "validate": "node scripts/validate-artifact.mjs",
    "verify:sandbox": "node --env-file-if-exists=.env scripts/verify-sandbox.mjs",
    "eval": "node --env-file-if-exists=.env scripts/evaluate.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ag-grid-community": "36.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
