{
  "info": {
    "name": "RecallRelay · verified remedies",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use replay locally with a cookie jar or sandbox with a merchant token. A real refund always requires separate human confirmation. Never publish token values."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:4173"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "claim_id",
      "value": "case-RR-1042"
    },
    {
      "key": "purchase_id",
      "value": ""
    },
    {
      "key": "evidence_revision",
      "value": "1"
    }
  ],
  "item": [
