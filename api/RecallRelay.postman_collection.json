        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"postman-purchase-001\",\n  \"mixed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"purchase_id\",pm.response.json().id);",
              "pm.test(\"Server priced mixed order\",()=>pm.expect(pm.response.json().totalCents).to.eql(7700));"
            ]
          }
        }
      ]
    },
